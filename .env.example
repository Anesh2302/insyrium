# ── Insyrium Portal — environment template ──
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

DATABASE_URL=mysql+pymysql://insyrium_app:PASSWORD@localhost:3306/insyrium

PORTAL_NAME=Insyrium Portal

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
DEV_CONSOLE_OTP=true

MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@insyrium.com

ALLOW_REGISTRATION=true
FORCE_HTTPS=false
